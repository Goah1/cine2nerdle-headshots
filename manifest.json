{
	"manifest_version": 2,
	"name": "C2N Actor Headshots",
	"version": "1.1",

	"icons": {
		"48": "icons/icon.png"
	},

	"data_collection_permissions": {
		"collecting": false
	},

	"permissions": [
		"https://api.themoviedb.org/*",
		"https://image.tmdb.org/*",
		"storage"
	],
	"background": {
		"scripts": ["background.js"],
		"persistent": false
	},

	"browser_action": {
		"default_icon": "icons/icon.png",
		"default_title": "Cine2Nerdle Headshots",
		"default_popup": "popup/settings.html"
	},

	"content_scripts": [
		{
			"matches": ["*://*.cinenerdle2.app/*"],
			"js": ["content_scripts/testingDOM.js"],
			"css": ["content_scripts/styles.css"]
		}
	]
}
